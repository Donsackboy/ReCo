# Root ignore rules for caches, build artifacts and editor files

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
pip-wheel-metadata/
htmlcov/
coverage/
.coverage

# Node / frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
build/

# Logs
logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
.DS_Store

# Misc caches
.cache/
